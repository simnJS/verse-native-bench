# One item per index, called on its own by cli and uefn: on the BPVM, suspending between two items
# (CommitPoint, Sleep) commits the transaction and frees its memory. false after the last one.
RunCheck<public>(Index:int)<transacts>:?[]accuracy_report =
    case (Index):
        0 => option{array{CheckSqrt()}}
        1 => option{array{CheckClamp()}}
        2 => option{array{CheckMinMax()}}
        3 => option{array{CheckSgn()}}
        4 => option{CheckAbsLerp()}
        5 => option{CheckRounding()}
        6 => option{CheckIntMath()}
        7 => option{CheckArrays()}
        8 => option{CheckDegrees()}
        9 => option{array{CheckDotProduct()}}
        10 => option{array{CheckCrossProduct()}}
        11 => option{array{CheckDistance()}}
        12 => option{array{CheckDistanceSquared()}}
        13 => option{array{CheckDistanceXY(), CheckDistanceSquaredXY()}}
        14 => option{CheckLength()}
        15 => option{array{CheckIsFiniteVector()}}
        16 => option{array{CheckMakeUnitVector()}}
        17 => option{array{CheckLerpVector()}}
        18 => option{array{CheckReflectVector()}}
        19 => option{array{CheckLocalAxes()}}
        20 => option{array{CheckApplyLocalRotation()}}
        21 => option{CheckTransformVector()}
        22 => option{CheckVector2()}
        23 => option{array{CheckEquals2i()}}
        24 => option{VerseSpatialBench.RunVerseChecks()}
        25 => option{VerseRotationBench.RunVerseRotationChecks()}
        26 => option{TupleMathBench.RunTupleChecks()}
        27 => option{CheckTranscendental()}
        28 => option{CheckSort()}
        29 => option{CheckEasing()}
        _ => false

RunBench<public>(Index:int, Inputs:bench_inputs)<transacts>:?float =
    case (Index):
        0 => option{BenchSqrt(Inputs.Count)}
        1 => option{BenchClamp(Inputs.Floats)}
        2 => option{BenchMinMax(Inputs.Floats)}
        3 => option{BenchSgn(Inputs.Floats)}
        4 => option{BenchAbsLerp(Inputs.Floats)}
        5 => option{BenchRounding(Inputs.Floats)}
        6 => option{BenchIntMath(Inputs.IntPairs)}
        7 => option{BenchArraySearch(Inputs.Arrays)}
        8 => option{BenchArrayEdit(Inputs.Arrays)}
        9 => option{BenchConcatenate(Inputs.Arrays)}
        10 => option{BenchReplaceAll(Inputs.Arrays)}
        11 => option{BenchToString(Inputs.IntPairs)}
        12 => option{BenchDegrees(Inputs.Floats)}
        13 => option{BenchDotProduct(Inputs.Pairs)}
        14 => option{BenchCrossProduct(Inputs.Pairs)}
        15 => option{BenchDistance(Inputs.Pairs)}
        16 => option{BenchDistanceSquared(Inputs.Pairs)}
        17 => option{BenchDistanceXY(Inputs.Pairs)}
        18 => option{BenchLength(Inputs.Vectors)}
        19 => option{BenchIsFiniteVector(Inputs.Vectors)}
        20 => option{BenchMakeUnitVector(Inputs.Vectors)}
        21 => option{BenchLerpVector(Inputs.Pairs)}
        22 => option{BenchReflectVector(Inputs.Pairs)}
        23 => option{BenchLocalAxes(Inputs.Rotations)}
        24 => option{BenchApplyLocalRotation(Inputs.Rotations)}
        25 => option{BenchTransformVector(Inputs.UnitScaleTransforms)}
        26 => option{BenchTransformVectorScaled(Inputs.ScaledTransforms)}
        27 => option{BenchVector2(Inputs.Vectors2, Inputs.Pairs2)}
        28 => option{BenchVector2Shape(Inputs.Vectors2, Inputs.Pairs2)}
        29 => option{BenchEquals2i(Inputs.IntPairs2)}
        30 => option{VerseSpatialBench.RunVerseBenches(Inputs.VerseOrg)}
        31 => option{VerseRotationBench.RunVerseRotationBenches(Inputs.VerseOrg)}
        32 => option{TupleMathBench.RunTupleBenches(Inputs.Tuples)}
        33 => option{TupleMathBench.RunHomingBenches(Inputs.Tuples)}
        34 => option{BenchTrig(Inputs.Floats)}
        35 => option{BenchExpLn(Inputs.Floats)}
        36 => option{BenchInverseTrig(Inputs.Floats)}
        37 => option{BenchHyperbolic(Inputs.Floats)}
        38 => option{BenchPowInt(Inputs.Floats)}
        39 => option{BenchSort(Inputs.Floats)}
        40 => option{BenchEasing(Inputs.Floats)}
        _ => false
